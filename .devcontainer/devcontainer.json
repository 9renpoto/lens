{
	"name": "Devcontainer",
	"image": "elixir:1.18.3-slim",
	"features": {
		"ghcr.io/devcontainers-extra/features/lefthook-asdf:1": {
			"version": "latest"
		},
		"ghcr.io/michidk/devcontainers-features/typos:1": {},
		"ghcr.io/jsburckhardt/devcontainer-features/zizmor:1": {}
	},
	"forwardPorts": [4000],
	"postCreateCommand": "mix local.hex --force && mix local.rebar --force && mix deps.get && lefthook install",
	"remoteUser": "root"
}
