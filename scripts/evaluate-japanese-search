#!/usr/bin/env sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
compose_file="$project_root/compose.evaluation.yml"

cleanup() {
  docker compose --file "$compose_file" down --volumes --remove-orphans >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

docker compose --file "$compose_file" up --detach --wait

docker compose --file "$compose_file" exec --no-TTY postgres \
  psql --username postgres --dbname evaluation \
  < "$project_root/priv/evaluation/japanese_search_corpus.sql"
