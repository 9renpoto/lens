#!/usr/bin/env bash

set -euo pipefail

duration_minutes="${1:-60}"

if ! [[ "$duration_minutes" =~ ^[1-9][0-9]*$ ]]; then
  echo "usage: scripts/soak [positive-duration-minutes]" >&2
  exit 2
fi

for ((iteration = 1; iteration <= duration_minutes; iteration++)); do
  printf 'soak iteration %d of %d\n' "$iteration" "$duration_minutes"
  mix test test/system/vertical_slice_test.exs --seed 0

  if ((iteration < duration_minutes)); then
    sleep 60
  fi
done
